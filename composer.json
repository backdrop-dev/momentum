{
    "name": "luthemes/momentum",
    "type": "classicpress-theme",
    "description": "Momentum is a minimal and flexible starter theme designed to provide a clean slate for developers. It focuses on simplicity and performance, making it ideal for building modern ClassicPress themes.",
    "keywords": [
        "classicpress",
        "theme"
    ],
    "homepage": "https://luthemes.com/portfolio/creativity",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Benjamin Lu",
            "email": "benlumia007@gmail.com",
            "homepage": "https://luthemes.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Momentum\\": "app"
        }
    },
    "require": {
        "php": ">=7.4",
        "backdrop-dev/framework": "1.0.x-dev",
        "backdrop-dev/customize": "dev-new-component",
        "backdrop-dev/fonts": "dev-develop",
        "backdrop-dev/mix": "dev-develop"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "*",
        "wptrt/wpthemereview": "*",
        "php-parallel-lint/php-parallel-lint": "*"
    },
    "scripts": {
        "lint:cpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs .",
        "lint:php": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor ."
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
